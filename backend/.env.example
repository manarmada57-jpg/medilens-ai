# ==============================================================================
# MediLens AI — Environment Configuration
# Copy this file to .env and fill in ALL required values before running.
# NEVER commit .env to version control.
# ==============================================================================

APP_ENV=development
APP_NAME=MediLens AI Backend
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (MongoDB)
# For Docker Compose: include credentials in URI
#   MONGODB_URI=mongodb://medilens:YOURPASSWORD@mongodb:27017/medilens_db?authSource=admin
# For local dev without auth:
#   MONGODB_URI=mongodb://localhost:27017
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=medilens_db
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# MongoDB root credentials (used by docker-compose to initialize the DB)
# Generate password with: openssl rand -hex 24
MONGO_ROOT_USER=medilens
MONGO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication & Security
# REQUIRED — generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=medilens-ai
JWT_AUDIENCE=medilens-users
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Medical Data Field-Level Encryption
# REQUIRED — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For key rotation: comma-separate keys, newest first.
#   FIELD_ENCRYPTION_KEYS=<new_key>,<old_key>
# ---------------------------------------------------------------------------
FIELD_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------
# Storage & Upload Pipeline (Phases 4-7)
# ---------------------------------------------------------------------------
UPLOAD_DIR=/tmp/medilens/uploads
MAX_DOC_BYTES=20971520
MAX_MEDIA_BYTES=20971520
DOC_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/heic
MEDIA_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/webm

# ---------------------------------------------------------------------------
# AI / LLM Provider Configuration (Phases 5-7)
# Supported: gemini, claude, openai
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PRIMARY_MODEL=gemini-2.0-flash
VISION_MODEL=gemini-2.0-flash
