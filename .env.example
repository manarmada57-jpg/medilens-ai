# ==============================================================================
# MediLens AI — Root Environment Variables Template
# Copy this file to .env and configure for local, staging, or production.
# NEVER commit real secret keys, credentials, or .env files to version control.
# ==============================================================================

# ── Application Environment ──
# Valid options: development, staging, production, testing
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── CORS Allowed Origins (Comma-separated) ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Frontend Configuration ──
VITE_API_URL=http://localhost:8000/api
VITE_USE_MOCKS=false

# ── Security & Authentication ──
# Generate a secure 64-character hex secret with:
# openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_hex_secret_min_32_characters_long

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Field-Level Data Encryption ──
# MultiFernet key rotation list (comma-separated, newest key listed first).
# Generate each 44-character URL-safe base64 key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=your_primary_fernet_key_here=

# ── Database Configuration (MongoDB) ──
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=medilens_db
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# ── Storage & Uploads ──
UPLOAD_DIR=/tmp/medilens/uploads
MAX_DOC_BYTES=20971520
MAX_MEDIA_BYTES=20971520

# ── AI & LLM Provider ──
# Supported: gemini, anthropic, openai
LLM_PROVIDER=gemini
PRIMARY_MODEL=gemini-2.0-flash
VISION_MODEL=gemini-2.0-flash

# API Keys (Set on backend only; never expose in frontend)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Emergency Hotlines (Defaults for India) ──
EMERGENCY_NUMBER_PRIMARY=112
EMERGENCY_NUMBER_AMBULANCE=108

# ── Web Push Notification VAPID Keys ──
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:support@medilens.ai
