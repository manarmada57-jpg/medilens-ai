# ==============================================================================
# MediLens AI — Root Environment Variables Template
# Copy this file to .env and configure for local or staging environments.
# NEVER commit real secret keys or production passwords to version control.
# ==============================================================================

# ── General Settings ──
PROJECT_NAME="MediLens AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Frontend Configuration ──
VITE_API_URL=http://localhost:8000/api
VITE_USE_MOCKS=false

# ── Backend Configuration ──
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# ── Security & Cryptography (Generate with: openssl rand -hex 32) ──
SECRET_KEY=generate_with_openssl_rand_hex_32_minimum_64_characters_for_prod
# MultiFernet base64-encoded 32-byte key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PROFILE_ENCRYPTION_KEY=your_fernet_base64_encryption_key_here=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MongoDB Connection (Authenticated) ──
MONGO_ROOT_USER=medilens_admin
MONGO_ROOT_PASSWORD=change_this_secure_mongo_password_in_prod
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=medilens_db
MONGO_URI=mongodb://medilens_admin:change_this_secure_mongo_password_in_prod@mongodb:27017/medilens_db?authSource=admin

# ── Redis / Job Queue ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Emergency Hotlines (Defaults for India) ──
EMERGENCY_NUMBER_PRIMARY=112
EMERGENCY_NUMBER_AMBULANCE=108

# ── Web Push Notification VAPID Keys ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:support@medilens.ai

# ── AI Provider (Run on backend worker only; never in browser) ──
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
